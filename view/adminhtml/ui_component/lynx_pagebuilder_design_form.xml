<!-- A design's name and parents; its content is edited in the builder. -->
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">lynx_pagebuilder_design_form.design_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Design</item>
        <!-- collapsible, not the default template: that one needs an "areas" child and renders nothing without tabs. -->
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="back" class="OOCS\LynxPageBuilder\Block\Adminhtml\Design\Edit\BackButton"/>
            <button name="layouts" class="OOCS\LynxPageBuilder\Block\Adminhtml\Design\Edit\LayoutsButton"/>
            <button name="save" class="OOCS\LynxPageBuilder\Block\Adminhtml\Design\Edit\SaveButton"/>
        </buttons>
        <namespace>lynx_pagebuilder_design_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>lynx_pagebuilder_design_form.design_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="design_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="*/*/save"/>
        </settings>
        <dataProvider name="design_form_data_source"
                      class="OOCS\LynxPageBuilder\Ui\DataProvider\Design\FormDataProvider">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general">
        <settings>
            <label/>
        </settings>
        <field name="id" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">design</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
                <dataScope>id</dataScope>
            </settings>
        </field>
        <field name="name" formElement="input" sortOrder="10">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">design</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Name</label>
                <dataScope>name</dataScope>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>
        <field name="description" formElement="textarea" sortOrder="20">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">design</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Description</label>
                <dataScope>description</dataScope>
            </settings>
        </field>
        <!-- Parents as {design, position} rows dragged into order; `position` is posted only, Design\Save sorts by it. -->
        <dynamicRows name="parents" sortOrder="30">
            <settings>
                <label translate="true">Parent Designs</label>
                <addButtonLabel translate="true">Add Parent Design</addButtonLabel>
                <additionalClasses>
                    <class name="admin__field-wide">true</class>
                </additionalClasses>
                <componentType>dynamicRows</componentType>
                <defaultRecord>false</defaultRecord>
                <columnsHeader>true</columnsHeader>
                <dndConfig>
                    <param name="enabled" xsi:type="boolean">true</param>
                </dndConfig>
                <notice translate="true">A page this design has no layout for is taken from the first parent that has one. Drag to change the order.</notice>
            </settings>
            <container name="record" component="Magento_Ui/js/dynamic-rows/record">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="isTemplate" xsi:type="boolean">true</item>
                        <item name="is_collection" xsi:type="boolean">true</item>
                        <item name="componentType" xsi:type="string">container</item>
                        <item name="positionProvider" xsi:type="string">position</item>
                    </item>
                </argument>
                <field name="design" formElement="select" sortOrder="10">
                    <settings>
                        <dataType>text</dataType>
                        <dataScope>design</dataScope>
                        <label translate="true">Design</label>
                        <validation>
                            <rule name="required-entry" xsi:type="boolean">true</rule>
                        </validation>
                    </settings>
                    <formElements>
                        <select>
                            <settings>
                                <options class="OOCS\LynxPageBuilder\Model\Config\Source\ParentDesign"/>
                            </settings>
                        </select>
                    </formElements>
                </field>
                <field name="position" formElement="input" sortOrder="20">
                    <settings>
                        <dataType>number</dataType>
                        <dataScope>position</dataScope>
                        <visible>false</visible>
                    </settings>
                </field>
                <actionDelete>
                    <settings>
                        <componentType>actionDelete</componentType>
                        <dataType>text</dataType>
                        <label translate="true">Actions</label>
                    </settings>
                </actionDelete>
            </container>
        </dynamicRows>
    </fieldset>
</form>
