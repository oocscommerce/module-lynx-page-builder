<!-- The layouts of one design; deleting a row falls back to the parents. design_id comes from the URL (filterUrlParams,
     carried to MassDelete by DeleteLayouts). -->
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">lynx_pagebuilder_layout_listing.lynx_pagebuilder_layout_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>lynx_pagebuilder_layout_columns</spinner>
        <deps>
            <dep>lynx_pagebuilder_layout_listing.lynx_pagebuilder_layout_listing_data_source</dep>
        </deps>
        <buttons>
            <button name="back">
                <url path="lynxpagebuilder/design/index"/>
                <class>back</class>
                <label translate="true">Back</label>
            </button>
        </buttons>
    </settings>
    <dataSource name="lynx_pagebuilder_layout_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <!-- The table's key is `id`, not entity_id — see the design listing. -->
            <storageConfig>
                <param name="indexField" xsi:type="string">id</param>
            </storageConfig>
            <filterUrlParams>
                <param name="design_id">*</param>
            </filterUrlParams>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>OOCS_LynxPageBuilder::manage</aclResource>
        <dataProvider name="lynx_pagebuilder_layout_listing_data_source"
                      class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <massaction name="listing_massaction">
            <action name="delete" class="OOCS\LynxPageBuilder\Ui\Component\Listing\MassAction\DeleteLayouts">
                <settings>
                    <confirm>
                        <title translate="true">Delete layouts</title>
                        <message translate="true">The selected pages will be read from this design's parent designs instead, or be empty if it has none. Continue?</message>
                    </confirm>
                    <url path="lynxpagebuilder/layout/massDelete"/>
                    <type>delete</type>
                    <label translate="true">Delete</label>
                </settings>
            </action>
        </massaction>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="lynx_pagebuilder_layout_columns">
        <selectionsColumn name="ids">
            <settings>
                <indexField>id</indexField>
            </settings>
        </selectionsColumn>
        <column name="id" sortOrder="10">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
            </settings>
        </column>
        <column name="path" sortOrder="20">
            <settings>
                <filter>text</filter>
                <label translate="true">Path</label>
            </settings>
        </column>
        <column name="page" class="OOCS\LynxPageBuilder\Ui\Component\Listing\Column\LayoutPage" sortOrder="30">
            <settings>
                <sortable>false</sortable>
                <label translate="true">Page</label>
            </settings>
        </column>
        <column name="updated_at" class="Magento\Ui\Component\Listing\Columns\Date"
                component="Magento_Ui/js/grid/columns/date" sortOrder="40">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Modified</label>
                <sorting>desc</sorting>
            </settings>
        </column>
    </columns>
</listing>
