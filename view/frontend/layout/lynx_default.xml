<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- The design's CSS in <head> -->
        <referenceBlock name="head.additional">
            <block class="Magento\Framework\View\Element\Template" name="lynx.theme.css"
                   template="OOCS_LynxPageBuilder::theme-css.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">OOCS\LynxPageBuilder\ViewModel\ThemeCss</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
