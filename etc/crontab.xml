<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job name="lynx_pagebuilder_share_cleanup" instance="OOCS\LynxPageBuilder\Cron\CleanShares" method="execute">
            <!-- Daily, at night: an expired link opens nothing, it only takes up a row. -->
            <schedule>0 3 * * *</schedule>
        </job>
    </group>
</config>
